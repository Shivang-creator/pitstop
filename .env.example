# ---------------------------------------------------------------------------
# Pitstop configuration. Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# REQUIRED for `pitstop scan` on any public channel (read-only, no login).
# console.cloud.google.com -> APIs & Services -> Library -> "YouTube Data API v3"
#   -> Credentials -> Create Credentials -> API key
YOUTUBE_API_KEY=

# REQUIRED for `pitstop plan` / `pitstop apply` on a channel you own.
# Same project -> also enable "YouTube Analytics API"
#   -> OAuth consent screen: External, stay in Testing, add yourself as a test user
#   -> Scopes: youtube.force-ssl, yt-analytics.readonly
#   -> Credentials -> Create OAuth client ID -> Desktop app -> Download JSON
# Save that file as client_secret.json in the project root; the path below points at it.
PITSTOP_CLIENT_SECRET_FILE=client_secret.json

# Where the OAuth refresh token gets cached after the first `pitstop auth`.
PITSTOP_TOKEN_FILE=.pitstop/token.json

# Local cache of the fetched catalog + findings.
PITSTOP_DB=.pitstop/pitstop.db

# ---------------------------------------------------------------------------
# Optional: LLM provider for chapter generation and ad-suitability risk checks.
# Leave blank to have those checks degrade gracefully (they skip, they don't crash).
# ---------------------------------------------------------------------------
# Featherless (flat-rate, OpenAI-compatible)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3-0324

# Fallback: local gemini-router (round-robin proxy)
GEMINI_ROUTER_BASE_URL=http://127.0.0.1:8787/v1
GEMINI_ROUTER_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Safety rails
# ---------------------------------------------------------------------------
# Hard ceiling on quota units Pitstop will spend in a single `apply` run.
# YouTube gives 10,000 units/day; videos.update costs 50, so 10,000 = 200 edits.
PITSTOP_QUOTA_BUDGET=9000

# Never apply changes without an explicit --yes or UI confirmation.
PITSTOP_REQUIRE_CONFIRM=true
